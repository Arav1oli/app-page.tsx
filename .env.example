DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudflare ---
# DO NOT commit real values here. In Claude Code on the web, paste these once
# into the environment's Secrets/Environment Variables panel so they persist
# privately across sessions and are injected automatically. The egress
# allowlist must also include api.cloudflare.com for outbound API calls.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
