# Copy this file to `.env` (NOT .env.local) and fill in the values:
#     cp .env.example .env
#
# Why .env and not .env.local?
# Next.js reads both, but the Prisma CLI ONLY reads .env. Putting DATABASE_URL
# in .env.local makes `prisma db push` and `npm run db:seed` fail with a
# confusing "Environment variable not found: DATABASE_URL" error.
# One file both tools read = no surprises.
#
# .env is gitignored, so it does NOT survive a fresh clone or a rebuilt
# container. If the app suddenly refuses to start, recreate this file first.

# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
#
# Production (PostgreSQL — Neon, Supabase, etc). Also change the `provider`
# in prisma/schema.prisma from "sqlite" to "postgresql".
#
# Use the POOLED connection string here — serverless functions open many
# short-lived connections and will exhaust a direct connection limit:
# DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
#
# ...and the DIRECT (non-pooled) string here. Migrations need session-long
# locks that a connection pooler cannot hold, so Prisma needs both.
# Requires adding `directUrl = env("DIRECT_URL")` to prisma/schema.prisma.
# DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Authentication ──────────────────────────────────────────────────────────
# Generate a real one with:  openssl rand -base64 32
# Never reuse the example value, and never commit the real one.
NEXTAUTH_SECRET="replace-me-run-openssl-rand-base64-32"

# The full public URL the app is served from.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"
